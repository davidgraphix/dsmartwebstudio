# ---------------------------------------------------------------------------
# DSmart Web Studio — environment variables
# Copy to .env.local and fill in. Never commit real credentials.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://dsmartwebstudio.com

# --- Email (Nodemailer) ----------------------------------------------------
# Server-only. These are never exposed to the browser.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dsmartwebstudio@gmail.com
SMTP_PASSWORD=your-app-password
# Optional overrides
# SMTP_SECURE=false
# MAIL_FROM="DSmart Web Studio <dsmartwebstudio@gmail.com>"
MAIL_TO=dsmartwebstudio@gmail.com

# --- WhatsApp Cloud API (optional) -----------------------------------------
# Leave unset to run click-to-chat only. Setting these enables real
# server-side WhatsApp notifications for new quote requests.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_NOTIFY_TO=2348160499031,2349035177568
# WHATSAPP_TEMPLATE_NAME=new_project_inquiry
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_API_VERSION=v21.0

# --- Currency --------------------------------------------------------------
# Optional override for the NGN-based exchange-rate source.
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/NGN

# --- Analytics (optional) --------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Search Console (optional) ---------------------------------------------
# GOOGLE_SITE_VERIFICATION=
