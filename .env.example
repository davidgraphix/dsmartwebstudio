# ---------------------------------------------------------------------------
# DSmart Web Studio — environment variables
# Copy to .env.local and fill in. Never commit real credentials.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG tags).
# Point this at whatever is actually live. Switch to the custom domain only
# once it resolves and serves the production deployment.
NEXT_PUBLIC_SITE_URL=https://dsmartwebstudio.vercel.app

# --- Email (Nodemailer) ----------------------------------------------------
# Server-only. These are never exposed to the browser.
SMTP_HOST=smtp.gmail.com
# 465 (implicit TLS) is the safer default: many ISPs and office networks block
# outbound 587. SMTP_SECURE is derived from this automatically.
SMTP_PORT=465
# The Gmail account that actually owns the app password. It need not be the
# studio inbox — MAIL_TO controls where inquiries are delivered.
SMTP_USER=account-that-owns-the-app-password@gmail.com
# Google shows app passwords as four groups of four. Spaces are stripped
# automatically, so either form works here.
SMTP_PASSWORD=your-app-password
# Optional overrides
# SMTP_SECURE=false
# MAIL_FROM must match SMTP_USER — Gmail rejects any other sender address.
# Leave unset to send as the authenticated account.
# MAIL_FROM="DSmart Web Studio <account-that-owns-the-app-password@gmail.com>"
MAIL_TO=dsmartwebstudio@gmail.com

# --- WhatsApp Cloud API (optional) -----------------------------------------
# Leave unset to run click-to-chat only. Setting these enables real
# server-side WhatsApp notifications for new quote requests.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_NOTIFY_TO=2348160499031,2349035177568
# WHATSAPP_TEMPLATE_NAME=new_project_inquiry
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_API_VERSION=v21.0

# --- Currency --------------------------------------------------------------
# Optional override for the NGN-based exchange-rate source.
# EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/NGN

# --- Analytics (optional) --------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Search Console (optional) ---------------------------------------------
# GOOGLE_SITE_VERIFICATION=
